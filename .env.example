# ============================================================================
# VAKYAM — Environment Variables & Local Build Configuration (.env.example)
# ============================================================================
# Vakyam is a 100% offline, on-device Android application (zero cloud APIs,
# zero paid keys, zero telemetry). Copy or export these variables when building
# from the command line or configuring custom on-device model paths.
# ============================================================================

# 1. Android SDK & JDK Paths (Required for CLI Gradle builds)
ANDROID_HOME="C:/Users/<username>/AppData/Local/Android/Sdk"
JAVA_HOME="C:/Program Files/Android/Android Studio/jbr"

# 2. On-Device LLM Runtime Configuration (Google LiteRT-LM — Gemma 4 E2B)
# Default device path where Vakyam loads the quantized Gemma 4 E2B model:
VAKYAM_LITERTLM_MODEL_FILENAME="gemma-4-E2B-it.litertlm"
VAKYAM_LITERTLM_DEVICE_DIR="/sdcard/Download"
# Preferred hardware accelerator: "GPU" (default, ~1.36s latency) or "CPU" (fallback)
VAKYAM_LITERTLM_BACKEND="GPU"
VAKYAM_LITERTLM_MAX_OUTPUT_TOKENS="64"

# 3. Offline Speech Recognition Configuration (Sherpa-ONNX Whisper Base int8)
# Bundled inside APK assets; no external download required:
VAKYAM_WHISPER_ASSET_DIR="whisper-base"
VAKYAM_WHISPER_ENCODER="base-encoder.int8.onnx"
VAKYAM_WHISPER_DECODER="base-decoder.int8.onnx"
VAKYAM_WHISPER_TOKENS="base-tokens.txt"

# 4. Gaze & Sensor Pipeline Tuning Defaults (Configurable in-app via Settings)
VAKYAM_DWELL_DIRECTIONAL_MS="300"
VAKYAM_DWELL_EYE_CLOSED_MS="450"
VAKYAM_BLINK_MIN_DURATION_MS="350"
VAKYAM_BLINK_MAX_DURATION_MS="1200"
VAKYAM_LOW_LIGHT_LUX_THRESHOLD="10.0"
VAKYAM_BATTERY_WARN_TEMP_C="42.0"
VAKYAM_BATTERY_CRITICAL_TEMP_C="45.0"
